# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/khet-se

# ── Auth ─────────────────────────────────────────────
# Use a long random string in production: `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Sessions: a short-lived access token plus a revocable refresh token (rotated on use).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie settings — for a client on a different domain in production use
# COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Optional services (used from later phases) ───────
# Optional. When empty, an in-process cache is used (fine for a single instance).
REDIS_URL=
# Hosts farmers' photo links may use (comma-separated).
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,images.unsplash.com,upload.wikimedia.org
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OSRM_URL=https://router.project-osrm.org
# OpenStreetMap Nominatim geocoding (search / reverse). Set a User-Agent that identifies
# your deployment, per https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=KhetSe/0.1 (development)

# ── Recommendations ──────────────────────────────────
# Initial search radius around the customer, and the furthest it may auto-expand to.
REC_DEFAULT_RADIUS_KM=8
REC_MAX_RADIUS_KM=25
# Adds road distance (OSRM) to the top nearby farms. Use your own OSRM instance in production.
ROAD_DISTANCE_ENABLED=false

# ── Payments ─────────────────────────────────────────
# Razorpay test-mode keys from https://dashboard.razorpay.com (Settings → API Keys).
# Leave empty to offer cash on delivery only. The webhook secret is set when you add a
# webhook pointing at  <API_URL>/api/payments/razorpay/webhook  (event: payment.captured).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Orders ───────────────────────────────────────────
# Hours a farmer has to accept a new order before it is cancelled and its stock released.
FARMER_ACCEPT_HOURS=24

# ── Public URLs ──────────────────────────────────────
# Web app (links in emails, where sign-in lands) and this API as browsers reach it (Google
# redirects back to <API_PUBLIC_URL>/api/auth/google/callback). Defaults suit local dev.
# WEB_URL=https://khetse.in
# API_PUBLIC_URL=https://api.khetse.in

# ── Email (password reset) ───────────────────────────
# "log" prints emails (with the reset link) to this server's log in development.
# For real email use "resend" (resend.com) or "brevo" (brevo.com) with an API key, and a
# From address on a domain you have verified with that provider.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=Khet Se <no-reply@khetse.in>
PASSWORD_RESET_TTL_MINUTES=30

# ── Continue with Google ─────────────────────────────
# OAuth client (type "Web application") from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5000/api/auth/google/callback (and your production
# API URL). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
